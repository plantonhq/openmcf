# Computed values for the KubernetesArgocd module. Every resolution here
# has an exact twin in the Pulumi module's locals.go / values.go — keep
# them in lockstep.
#
# SECRET DISCIPLINE (load-bearing): nothing in this module transports
# credential material. The initial admin password is generated by Argo CD
# ITSELF at first start into the fixed-name `argocd-initial-admin-secret`;
# the OIDC client secret and Dex connector secrets ride Argo CD's own
# `$<secret-name>:<key>` runtime indirection against labeled Secrets;
# external-Redis credentials ride the chart's existingSecret contract; and
# private-repo credentials are labeled Secrets composed OUTSIDE this
# module (the spec's REPOSITORY CREDENTIALS teaching).
#
# HCL DISCIPLINE (applies to every conditional object in this file):
# conditional entries are written as `key = cond ? value : null` inside ONE
# object literal, pruned with `{ for k, v in {...} : k => v if v != null }`.
# `cond ? {...} : {}` ternaries fail plan-time type unification when
# branches carry different attributes, and merge() over primitive-only
# sibling objects silently UNIFIES them into map(string). Optional nested
# blocks are read with try() (HCL's && does NOT short-circuit); optional
# scalars inside optional blocks with try(coalesce(x), null).

locals {
  # Chart identity — must stay byte-identical with the Pulumi module's
  # vars. The argo-cd chart is served from the argoproj GitHub-pages
  # index; chart 10.2.1 ships Argo CD v3.4.5.
  helm_chart_name = "argo-cd"
  helm_chart_repo = "https://argoproj.github.io/argo-helm"

  # Release name — metadata.name, NOT a fixed chart name: several Argo CD
  # instances can coexist in one cluster (one per namespace when using
  # the generated admin password — the app fixes that Secret's name).
  # fullnameOverride below pins every chart child name to this.
  release_name = var.metadata.name

  # Chart version resolved to the pinned default when unset, so both
  # engines install the same chart whether or not the platform's
  # defaulting middleware ran.
  chart_version = coalesce(var.spec.chart_version, "10.2.1")

  namespace = var.spec.namespace

  # Resource-identity labels stamped on the module-created satellites
  # (the namespace — never injected into the chart's own resources; Helm
  # owns those).
  labels = merge(
    {
      "planton.ai/resource"      = "true"
      "planton.ai/resource-name" = var.metadata.name
      "planton.ai/resource-kind" = "KubernetesArgocd"
    },
    var.metadata.id != null && var.metadata.id != "" ? { "planton.ai/resource-id" = var.metadata.id } : {},
    var.metadata.org != null && var.metadata.org != "" ? { "planton.ai/organization" = var.metadata.org } : {},
    var.metadata.env != null && var.metadata.env != "" ? { "planton.ai/environment" = var.metadata.env } : {}
  )

  # The API/UI server Service is `<fullname>-server` (the chart appends
  # each component's name to the fullname, which fullnameOverride pins to
  # the resource name). Feeds the exported handles.
  server_service_name = "${local.release_name}-server"

  # Argo CD serves HTTPS with a self-signed cert unless server.insecure
  # asks for plain HTTP behind composed TLS-terminating exposure. The
  # exported endpoint follows the declared scheme.
  server_insecure = try(var.spec.server.insecure, false)
  server_scheme   = local.server_insecure ? "http" : "https"

  # Fixed by the APPLICATION (util/settings): the generated initial admin
  # password Secret. Exported only while the admin user is enabled.
  admin_enabled             = try(coalesce(var.spec.admin_enabled), null) != null ? var.spec.admin_enabled : true
  initial_admin_secret_name = local.admin_enabled ? "argocd-initial-admin-secret" : ""

  # ---- redis arm ----------------------------------------------------------
  # The chart's own switch logic (verified in its redis.server helper):
  # bundled redis serves when redis.enabled && !redis-ha.enabled; the HA
  # subchart serves when redis-ha.enabled (haproxy fronting it); an
  # external endpoint serves only when the bundled arm is DISABLED and
  # externalRedis.host is set. The oneof renders exactly one of those
  # three states.
  redis_ha_declared       = try(var.spec.redis.ha, null) != null
  redis_external_declared = try(var.spec.redis.external, null) != null
  redis_bundled           = !local.redis_ha_declared && !local.redis_external_declared

  # ---- OIDC (configs.cm oidc.config) --------------------------------------
  # Rendered as the YAML document argocd-cm carries. The client secret
  # NEVER lands here: Argo CD resolves `$<secret-name>:<key>` at runtime
  # from a Secret labeled app.kubernetes.io/part-of: argocd. A public
  # client (no secret declared) gets PKCE instead.
  oidc_declared = try(var.spec.sso.oidc, null) != null
  oidc_config = local.oidc_declared ? yamlencode({
    for k, v in {
      name     = var.spec.sso.oidc.name
      issuer   = var.spec.sso.oidc.issuer
      clientID = var.spec.sso.oidc.client_id
      clientSecret = try(var.spec.sso.oidc.client_secret_secret, null) != null ? (
        format("$%s:%s", var.spec.sso.oidc.client_secret_secret.name, var.spec.sso.oidc.client_secret_secret.key)
      ) : null
      enablePKCEAuthentication = try(var.spec.sso.oidc.client_secret_secret, null) == null ? true : null
    } : k => v if v != null
  }) : null

  # ---- argocd-cm entries ----------------------------------------------------
  # Keys are the ConfigMap's own dotted names; only declared entries
  # render so the chart's defaults stay authoritative.
  configs_cm = {
    for k, v in {
      "admin.enabled"          = local.admin_enabled ? null : false
      "exec.enabled"           = var.spec.exec_enabled ? true : null
      "timeout.reconciliation" = var.spec.reconciliation_timeout != "" ? var.spec.reconciliation_timeout : null
      "oidc.config"            = local.oidc_config
      "dex.config"             = try(coalesce(var.spec.sso.dex_config), null)
    } : k => v if v != null
  }

  # ---- argocd-rbac-cm entries -------------------------------------------------
  rbac_declared = try(var.spec.rbac, null) != null
  configs_rbac = local.rbac_declared ? {
    for k, v in {
      "policy.default" = var.spec.rbac.policy_default != "" ? var.spec.rbac.policy_default : null
      "policy.csv"     = var.spec.rbac.policy_csv != "" ? var.spec.rbac.policy_csv : null
      scopes           = try(coalesce(var.spec.rbac.scopes), null)
    } : k => v if v != null
  } : {}

  # ---- public repository registrations ------------------------------------------
  # Each entry renders one chart-managed repository Secret carrying url +
  # type only — anonymous access by definition (the spec fences
  # credentialed repos to composed labeled Secrets).
  configs_repositories = {
    for r in var.spec.repositories : r.name => {
      url  = r.url
      type = try(coalesce(r.type), null) != null ? r.type : "git"
    }
  }

  # ---- shared component-shape helpers ---------------------------------------------
  # One rendering for the repeated {replicas, resources} component shape;
  # autoscaled components ignore `replicas` when their HPA is enabled
  # (the HPA owns the count — rendering both would fight it).
  resources_or_null = {
    controller      = try(var.spec.controller.resources, null)
    server          = try(var.spec.server.resources, null)
    repo_server     = try(var.spec.repo_server.resources, null)
    application_set = try(var.spec.application_set.resources, null)
    notifications   = try(var.spec.notifications.resources, null)
    dex             = try(var.spec.dex.resources, null)
    commit_server   = try(var.spec.commit_server.resources, null)
    redis_bundled   = try(var.spec.redis.bundled.resources, null)
  }

  rendered_resources = {
    for name, r in local.resources_or_null : name => r == null ? null : {
      for rk, rv in {
        requests = try(r.requests, null) == null ? null : {
          for qk, qv in {
            cpu    = r.requests.cpu != "" ? r.requests.cpu : null
            memory = r.requests.memory != "" ? r.requests.memory : null
          } : qk => qv if qv != null
        }
        limits = try(r.limits, null) == null ? null : {
          for lk, lv in {
            cpu    = r.limits.cpu != "" ? r.limits.cpu : null
            memory = r.limits.memory != "" ? r.limits.memory : null
          } : lk => lv if lv != null
        }
      } : rk => rv if rv != null && rv != {}
    }
  }

  server_autoscaling_enabled      = try(var.spec.server.autoscaling.enabled, false)
  repo_server_autoscaling_enabled = try(var.spec.repo_server.autoscaling.enabled, false)

  autoscaling_server = local.server_autoscaling_enabled ? {
    enabled     = true
    minReplicas = try(coalesce(var.spec.server.autoscaling.min_replicas), null) != null ? var.spec.server.autoscaling.min_replicas : 1
    maxReplicas = try(coalesce(var.spec.server.autoscaling.max_replicas), null) != null ? var.spec.server.autoscaling.max_replicas : 5
  } : null

  autoscaling_repo_server = local.repo_server_autoscaling_enabled ? {
    enabled     = true
    minReplicas = try(coalesce(var.spec.repo_server.autoscaling.min_replicas), null) != null ? var.spec.repo_server.autoscaling.min_replicas : 1
    maxReplicas = try(coalesce(var.spec.repo_server.autoscaling.max_replicas), null) != null ? var.spec.repo_server.autoscaling.max_replicas : 5
  } : null

  # Every component with a serviceMonitor toggle at the pin (controller,
  # server, repo server, applicationSet, notifications, dex) gets the
  # same metrics pair from the single spec toggle — partial monitoring of
  # a control plane is a trap. The commit server exposes NO
  # serviceMonitor toggle at chart 10.2.1 (metrics service only), and the
  # redis exporter is a separate opt-in sidecar surface — both stay
  # chart-default (reachable via helm_values).
  metrics_block = var.spec.service_monitors_enabled ? {
    metrics = {
      enabled        = true
      serviceMonitor = { enabled = true }
    }
  } : {}

  # ---- per-component blocks ----------------------------------------------------------
  controller_block = {
    for k, v in {
      replicas  = try(coalesce(var.spec.controller.replicas), null)
      resources = local.rendered_resources.controller
    } : k => v if v != null
  }

  server_block = {
    for k, v in {
      replicas    = local.server_autoscaling_enabled ? null : try(coalesce(var.spec.server.replicas), null)
      resources   = local.rendered_resources.server
      autoscaling = local.autoscaling_server
    } : k => v if v != null
  }

  repo_server_block = {
    for k, v in {
      replicas    = local.repo_server_autoscaling_enabled ? null : try(coalesce(var.spec.repo_server.replicas), null)
      resources   = local.rendered_resources.repo_server
      autoscaling = local.autoscaling_repo_server
    } : k => v if v != null
  }

  application_set_block = {
    for k, v in {
      replicas  = try(coalesce(var.spec.application_set.replicas), null)
      resources = local.rendered_resources.application_set
    } : k => v if v != null
  }

  notifications_block = {
    for k, v in {
      enabled   = try(coalesce(var.spec.notifications.enabled), null)
      resources = local.rendered_resources.notifications
    } : k => v if v != null
  }

  dex_block = {
    for k, v in {
      enabled   = try(coalesce(var.spec.dex.enabled), null)
      resources = local.rendered_resources.dex
    } : k => v if v != null
  }

  commit_server_block = {
    for k, v in {
      enabled   = try(coalesce(var.spec.commit_server.enabled), null)
      resources = local.rendered_resources.commit_server
    } : k => v if v != null
  }

  # ---- global block (image + scheduling + domain) ---------------------------------------
  # ONE Argo CD image serves every component; the chart's global.image
  # takes the repository COMBINED (registry included) — no split needed
  # here (unlike split-image charts; verified against the chart's global
  # section).
  image_declared = try(var.spec.image, null) != null && (
    try(var.spec.image.repository, "") != "" || try(var.spec.image.tag, "") != ""
  )

  global_block = {
    for k, v in {
      domain = var.spec.domain != "" ? var.spec.domain : null
      image = local.image_declared ? {
        for ik, iv in {
          repository = try(var.spec.image.repository, "") != "" ? var.spec.image.repository : null
          tag        = try(var.spec.image.tag, "") != "" ? var.spec.image.tag : null
        } : ik => iv if iv != null
      } : null
      imagePullSecrets = try(var.spec.image.pull_secret_name, "") != "" ? [
        { name = var.spec.image.pull_secret_name }
      ] : null
      nodeSelector = length(try(var.spec.scheduling.node_selector, {})) > 0 ? var.spec.scheduling.node_selector : null
      tolerations = length(try(var.spec.scheduling.tolerations, [])) > 0 ? [
        for t in var.spec.scheduling.tolerations : {
          for tk, tv in {
            key               = t.key != "" ? t.key : null
            operator          = t.operator != "" ? t.operator : null
            value             = t.value != "" ? t.value : null
            effect            = t.effect != "" ? t.effect : null
            tolerationSeconds = try(t.toleration_seconds, null)
          } : tk => tv if tv != null
        }
      ] : null
      priorityClassName = try(var.spec.scheduling.priority_class_name, "") != "" ? var.spec.scheduling.priority_class_name : null
    } : k => v if v != null
  }

  # The redis value block, shaped per arm with the null-prune idiom (the
  # bundled arm carries only optional resources; the external arm carries
  # enabled=false so the chart's switch falls through to externalRedis).
  redis_block = {
    for k, v in {
      enabled   = local.redis_external_declared ? false : null
      resources = local.redis_bundled ? local.rendered_resources.redis_bundled : null
    } : k => v if v != null
  }

  # ---- typed chart values (twin of the Pulumi module's buildHelmValues) --
  helm_values = {
    for k, v in {
      # fullnameOverride pins every child name (`<name>-server`,
      # `<name>-application-controller`, ...) to the resource name; the
      # exported outputs are built from that contract.
      fullnameOverride = local.release_name

      crds = try(var.spec.crds, null) != null ? {
        install = try(coalesce(var.spec.crds.install), null) != null ? var.spec.crds.install : true
        keep    = try(coalesce(var.spec.crds.keep), null) != null ? var.spec.crds.keep : true
      } : null

      global = length(local.global_block) > 0 ? local.global_block : null

      configs = {
        for ck, cv in {
          cm           = length(local.configs_cm) > 0 ? local.configs_cm : null
          params       = local.server_insecure ? { "server.insecure" = true } : null
          rbac         = length(local.configs_rbac) > 0 ? local.configs_rbac : null
          repositories = length(local.configs_repositories) > 0 ? local.configs_repositories : null
        } : ck => cv if cv != null
      }

      controller     = merge(local.controller_block, local.metrics_block)
      server         = merge(local.server_block, local.metrics_block)
      repoServer     = merge(local.repo_server_block, local.metrics_block)
      applicationSet = merge(local.application_set_block, local.metrics_block)
      notifications  = merge(local.notifications_block, local.metrics_block)
      dex            = merge(local.dex_block, local.metrics_block)
      commitServer   = local.commit_server_block

      # The redis arm: exactly one of the three states renders (the
      # chart's own switch logic — see the redis-arm locals above). The
      # bundled and external states carry different keys, so the block is
      # built as ONE pruned object (never a ternary between differently
      # shaped objects — the type-unification class).
      redis = length(local.redis_block) > 0 ? local.redis_block : null

      "redis-ha" = local.redis_ha_declared ? {
        for hk, hv in {
          enabled  = true
          replicas = try(coalesce(var.spec.redis.ha.replicas), null)
        } : hk => hv if hv != null
      } : null

      externalRedis = local.redis_external_declared ? {
        for ek, ev in {
          host           = var.spec.redis.external.host
          port           = try(coalesce(var.spec.redis.external.port), null) != null ? var.spec.redis.external.port : 6379
          existingSecret = var.spec.redis.external.credentials_secret_name != "" ? var.spec.redis.external.credentials_secret_name : null
        } : ek => ev if ev != null
      } : null
    } : k => v if v != null && v != {}
  }
}
