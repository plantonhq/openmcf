# The local user, addressed by the parent account's ARM ID -- a pure
# management-plane resource. Local users carry no Azure tags: ARM does
# not support tags on localUsers, so the platform's identity tags live
# on the account.
#
# Credential lifecycle quirks worth knowing (provider behavior, not
# module invention): the password is generated by Azure at the creation
# that enables ssh_password_enabled and returned exactly once -- and
# flipping ssh_password_enabled off and back on REGENERATES it (the old
# one stops working). SSH public keys are write-only in Azure's API (the
# GET never returns them), so the provider keeps them from its own
# state.
resource "azurerm_storage_account_local_user" "main" {
  name               = var.spec.user_name
  storage_account_id = var.spec.storage_account_id

  # At least one auth method is on (enforced in the spec). Sending the
  # booleans unconditionally is safe: false is the provider default on
  # both engines.
  ssh_key_enabled      = var.spec.ssh_key_enabled
  ssh_password_enabled = var.spec.ssh_password_enabled

  # Paired with ssh_key_enabled (the provider rejects keys without the
  # flag, and the flag without keys -- mirrored in the spec so it fails
  # at validate time, not apply time).
  dynamic "ssh_authorized_key" {
    for_each = var.spec.ssh_authorized_keys
    content {
      key         = ssh_authorized_key.value.key
      description = ssh_authorized_key.value.description == null || ssh_authorized_key.value.description == "" ? null : ssh_authorized_key.value.description
    }
  }

  home_directory = local.home_directory

  # Per-resource grants. The API stores permissions as an "rwdlc"
  # letter string; the provider exposes the five booleans -- the spec
  # models the same booleans, so this is a pass-through.
  dynamic "permission_scope" {
    for_each = var.spec.permission_scopes
    content {
      service       = local.service_map[permission_scope.value.service]
      resource_name = permission_scope.value.resource_name
      permissions {
        read   = permission_scope.value.read
        write  = permission_scope.value.write
        delete = permission_scope.value.delete
        list   = permission_scope.value.list
        create = permission_scope.value.create
      }
    }
  }
}
