    {
      "typeName": "AWS::IAM::Role",
      "identifier": "hub-ci-deployer",
      "properties": {
        "RoleName": "hub-ci-deployer",
        "RoleId": "AROA4QKBDLZ4FIXTURE01",
        "Arn": "arn:aws:iam::123456789012:role/ci/hub-ci-deployer",
        "Path": "/ci/",
        "Description": "CI deployment role for the hub account",
        "MaxSessionDuration": 7200,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "codebuild.amazonaws.com"},
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/ReadOnlyAccess"
        ],
        "Policies": [
          {
            "PolicyName": "deploy-artifacts-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:GetObject", "s3:PutObject"],
                  "Resource": "arn:aws:s3:::hub-deploy-artifacts/*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "Name", "Value": "hub-ci-deployer"},
          {"Key": "planton.ai/resource-kind", "Value": "AwsIamRole"},
          {"Key": "planton.ai/environment", "Value": "ops"},
          {"Key": "managed-by", "Value": "planton-e2e"}
        ]
      }
    },
