# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module and workspace files
!go.mod
!go.sum
!go.work

# Re-include embedded assets referenced by //go:embed directives
!internal/resources/manifests/**/*.tgz
!internal/resources/manifests/**/*.yaml
!internal/resources/manifests/**/*.json
!internal/keycloaklogintheme/*.woff2
