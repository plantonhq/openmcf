# GENERATED by `planton tofu generate-helm-crds` -- do not edit by hand. Every
# module that derives its CRDs carries this exact file; the drift test in
# pkg/iac/tofu/generators fails on any byte that differs, so a fix lands in
# the generator once and is regenerated everywhere.
#
# WHAT THIS FILE DOES
# Helm installs a chart's crds/ directory once and never upgrades or removes
# it, and templated CRDs are release-owned and die with the release. Charts
# that neither own their CRD lifecycle nor publish a separate CRD chart land
# on the DERIVE branch: this file renders the pinned chart with its CRD
# switch on (or fetches the pinned upstream bundle), keeps only the
# CustomResourceDefinition documents, stamps each with its source, and
# applies each one as a module-owned resource ahead of the release. The
# release (main.tf) installs with skip_crds = true and the chart's own CRD
# switch pinned off, so Helm never touches the CRDs. Chart bumps re-apply
# the CRDs at the new pin; destroy keeps them (apply_only) unless the spec
# says otherwise; reinstall re-adopts them (server-side apply); a schema
# downgrade is refused before anything is touched.
#
# THE LOCALS CONTRACT (defined by the module's locals.tf; the twin of the
# Pulumi module's keptcrds.Args):
#   helm_chart_repo, helm_chart_name, chart_version   chart identity (shared with the release)
#   release_name, namespace                           the identity the render runs under
#   helm_release_values         list(string)  the release's OWN values documents in helm -f order.
#                                             The release resource consumes the same list, so the
#                                             render can never see different values than the install.
#   helm_crds_render_override   string        one YAML document merged LAST: the chart's CRD switch
#                                             turned on (for example "crds:\n  create: true\n")
#   helm_crds_api_versions      list(string)  API versions the chart gates templates on
#                                             (.Capabilities.APIVersions); omitting one the chart
#                                             checks silently reshapes or drops a CRD
#   helm_crds_bundle_url        string        "" for charts that render their CRDs; for charts that
#                                             ship none, the upstream bundle URL with "{{version}}"
#                                             where the chart version goes (use the URL form that
#                                             survives the next upstream release)
#   helm_crds_enabled           bool          spec.crds.install (false = bring-your-own CRDs)
#   helm_crds_keep              bool          spec.crds.keep_on_uninstall
#
# WHY THE RENDER USES THE RELEASE'S FULL VALUES
# Templated CRDs depend on other values: the release's fullname, whether
# cert-manager injects the conversion CA or a self-signed one is frozen in,
# the webhook service port. A render from a minimal value set produces CRDs
# that point at the wrong webhook. Only the CRD switch differs.
#
# PROVIDERS
# helm (the render), http (the bundle fetch; declared even when unused,
# because init resolves every data source in the file), kubernetes (the live
# read behind the never-downgrade check), kubectl (the apply). All four are
# pinned in the module's provider.tf.
#
# NO depends_on ON THE DATA SOURCES, EVER: a data source that depends on a
# resource is deferred to apply time, and for_each keys unknown at plan time
# fail the plan.

locals {
  helm_crds_render = local.helm_crds_enabled && local.helm_crds_bundle_url == ""
  helm_crds_fetch  = local.helm_crds_enabled && local.helm_crds_bundle_url != ""

  # The source stamp: chart coordinates for the render branch, the URL
  # template for the bundle branch. The label carries only what a label
  # value may hold (the chart name, or the bundle host).
  helm_crds_source_description = local.helm_crds_bundle_url != "" ? local.helm_crds_bundle_url : "${trimsuffix(local.helm_chart_repo, "/")}/${local.helm_chart_name}"
  helm_crds_source_label       = local.helm_crds_bundle_url != "" ? regex("^https?://([^/]+)", local.helm_crds_bundle_url)[0] : local.helm_chart_name

  # Versions order as three numeric components folded into one number
  # (HCL orders numbers, not strings; the chart repository index publishes
  # semver, and no component reaches 10000). A version this pattern cannot
  # read is refused rather than guessed at.
  helm_crds_semver_pattern     = "^([0-9]+)\\.([0-9]+)\\.([0-9]+)"
  helm_crds_requested_sortable = can(regex(local.helm_crds_semver_pattern, local.chart_version)) ? tonumber(regex(local.helm_crds_semver_pattern, local.chart_version)[0]) * 100000000 + tonumber(regex(local.helm_crds_semver_pattern, local.chart_version)[1]) * 10000 + tonumber(regex(local.helm_crds_semver_pattern, local.chart_version)[2]) : null
}

# The repository index, read so a version that was never published is
# explained in the module's own words (the helm provider reports the same
# fact in Helm's words, which stay visible beside this one). OCI
# repositories have no index; the provider's text is the only one there.
data "http" "helm_crds_index" {
  count = local.helm_crds_render && startswith(local.helm_chart_repo, "http") ? 1 : 0

  url                = "${trimsuffix(local.helm_chart_repo, "/")}/index.yaml"
  request_timeout_ms = 60000

  lifecycle {
    postcondition {
      condition     = self.status_code != 200 || contains(try([for e in yamldecode(self.response_body).entries[local.helm_chart_name] : e.version], []), local.chart_version)
      error_message = "observed: chart ${local.helm_chart_name} ${local.chart_version} is not in the index of ${local.helm_chart_repo}\nmeaning: the pinned chart_version has not been published to that repository, or the version string is misspelled\nnext step: set spec.chart_version to a version listed at ${trimsuffix(local.helm_chart_repo, "/")}/index.yaml, then re-run"
    }
  }
}

# The render branch: the pinned chart, templated client-side with the
# release's own values plus the CRD switch, CRDs included. Templated CRDs
# arrive in manifests; crds/-directory CRDs arrive on crds. Both are read.
data "helm_template" "helm_crds" {
  count = local.helm_crds_render ? 1 : 0

  name         = local.release_name
  namespace    = local.namespace
  repository   = local.helm_chart_repo
  chart        = local.helm_chart_name
  version      = local.chart_version
  include_crds = true
  api_versions = local.helm_crds_api_versions
  values       = concat(local.helm_release_values, [local.helm_crds_render_override])

  lifecycle {
    postcondition {
      condition     = length([for d in split("\n---", "\n${join("\n---\n", concat(values(self.manifests), self.crds))}") : d if try(yamldecode(d).kind, "") == "CustomResourceDefinition"]) > 0
      error_message = "observed: rendering chart ${local.helm_chart_name} ${local.chart_version} with its CRD switch on (${trimspace(local.helm_crds_render_override)}) produced no CustomResourceDefinition documents\nmeaning: the chart's CRD switch is not the value the module sets at this version (upstream renamed it), or the chart stopped shipping CRDs\nnext step: read the chart's values at this version (helm show values ${local.helm_chart_name} --repo ${local.helm_chart_repo} --version ${local.chart_version}) and update the module's CRD override to the switch the chart uses"
    }
  }
}

# The bundle branch: charts that ship no CRDs publish them beside the chart.
data "http" "helm_crds_bundle" {
  count = local.helm_crds_fetch ? 1 : 0

  url                = replace(local.helm_crds_bundle_url, "{{version}}", local.chart_version)
  request_timeout_ms = 60000

  lifecycle {
    postcondition {
      condition     = self.status_code == 200
      error_message = "observed: the CRD bundle URL ${self.url} answered HTTP ${self.status_code}\nmeaning: ${self.status_code == 404 ? "no bundle is published at this version, or upstream changed the URL pattern" : "the upstream host is refusing or failing the request"}\nnext step: ${self.status_code == 404 ? "confirm version ${local.chart_version} exists at the upstream download page; set spec.chart_version to a published version, or correct the module's bundle URL template" : "retry once the host answers 200 (curl -I ${self.url}); if it persists, the upstream download location has changed"}"
    }
    postcondition {
      condition     = self.status_code != 200 || length([for d in split("\n---", "\n${self.response_body}") : d if try(yamldecode(d).kind, "") == "CustomResourceDefinition"]) > 0
      error_message = "observed: the CRD bundle at ${self.url} contained no CustomResourceDefinition documents\nmeaning: upstream changed what that URL serves, or the version has no CRD bundle\nnext step: open the URL, confirm it is the CRD bundle for this version, and correct the module's bundle URL template if upstream moved it"
    }
  }
}

# The never-downgrade read: every CRD this source has ever stamped on the
# cluster. A list call answers empty on a first install, so no special case.
data "kubernetes_resources" "helm_crds_existing" {
  count = local.helm_crds_enabled ? 1 : 0

  api_version    = "apiextensions.k8s.io/v1"
  kind           = "CustomResourceDefinition"
  label_selector = "planton.ai/crd-source=${local.helm_crds_source_label}"

  lifecycle {
    postcondition {
      condition     = local.helm_crds_requested_sortable != null
      error_message = "observed: the requested chart version \"${local.chart_version}\" is not a semantic version\nmeaning: the never-downgrade check cannot order versions it cannot parse, so it refuses rather than guess\nnext step: use the exact version string the chart repository index publishes (for example 0.120.0)"
    }
  }
}

locals {
  # What the cluster already carries from this source: CRD name -> the
  # chart version stamped on it (empty when unstamped, which never counts
  # as a downgrade). The refusal itself is the precondition on the apply
  # below, so it can name the CRD and the two versions.
  helm_crds_existing_versions = local.helm_crds_enabled ? {
    for o in data.kubernetes_resources.helm_crds_existing[0].objects :
    o.metadata.name => try(o.metadata.annotations["planton.ai/crd-source-version"], "")
  } : {}
  helm_crds_downgraded = [
    for name, version in local.helm_crds_existing_versions : { name = name, version = version }
    if version != "" && local.helm_crds_requested_sortable != null && can(regex(local.helm_crds_semver_pattern, version))
    && tonumber(regex(local.helm_crds_semver_pattern, version)[0]) * 100000000 + tonumber(regex(local.helm_crds_semver_pattern, version)[1]) * 10000 + tonumber(regex(local.helm_crds_semver_pattern, version)[2]) > local.helm_crds_requested_sortable
  ]

  # Every rendered or fetched document, split on separator LINES (a bare
  # "---" substring split corrupts CRDs whose descriptions embed ---).
  helm_crds_stream    = local.helm_crds_render ? join("\n---\n", concat(values(data.helm_template.helm_crds[0].manifests), data.helm_template.helm_crds[0].crds)) : (local.helm_crds_fetch ? data.http.helm_crds_bundle[0].response_body : "")
  helm_crds_documents = [for d in split("\n---", "\n${local.helm_crds_stream}") : d if trimspace(d) != "" && can(yamldecode(d))]

  # Keyed by each CRD's OWN metadata.name (never a positional index) so state
  # addresses stay stable across chart reorderings and match the Pulumi
  # twin's resource names.
  helm_crds_by_name = {
    for d in local.helm_crds_documents :
    yamldecode(d).metadata.name => yamldecode(d)
    if try(yamldecode(d).kind, "") == "CustomResourceDefinition"
  }

  # The stamps: where each CRD came from and at which version. Both engines
  # write the same keys; the never-downgrade read and the e2e verifiers read
  # them. The document round-trips through yamldecode/yamlencode (key order
  # may change; values and types do not).
  helm_crds_stamped = {
    for name, object in local.helm_crds_by_name :
    name => yamlencode(merge(object, {
      metadata = merge(object.metadata, {
        annotations = merge(
          try(object.metadata.annotations, null) == null ? {} : object.metadata.annotations,
          {
            "planton.ai/crd-source-chart"   = local.helm_crds_source_description
            "planton.ai/crd-source-version" = local.chart_version
          }
        )
        labels = merge(
          try(object.metadata.labels, null) == null ? {} : object.metadata.labels,
          { "planton.ai/crd-source" = local.helm_crds_source_label }
        )
      })
    }))
  }
}

# The module-owned CRDs, one per derived document. Server-side apply is
# required (a CRD past ~256 KB exceeds the client-side last-applied
# annotation cap) and adopts natively on reinstall; force_conflicts takes
# fields last written by another manager. apply_only makes Delete a no-op
# (the keep-on-uninstall posture); the spec turns it off when a destroy
# should take the CRDs with it.
resource "kubectl_manifest" "helm_crds" {
  for_each = local.helm_crds_stamped

  yaml_body = each.value

  server_side_apply = true
  force_conflicts   = true
  apply_only        = local.helm_crds_keep

  lifecycle {
    precondition {
      condition     = length(local.helm_crds_downgraded) == 0
      error_message = "observed: the cluster carries CRD ${try(local.helm_crds_downgraded[0].name, each.key)} derived from chart version ${try(local.helm_crds_downgraded[0].version, "?")}; the manifest asks for chart version ${local.chart_version}\nmeaning: applying an older CRD schema over a newer one can strip fields from existing custom resources the next time anything writes them\nnext step: set spec.chart_version to ${try(local.helm_crds_downgraded[0].version, "the cluster's version")} or higher; if you accept the loss and want the older schema, delete the CRD first (kubectl delete crd ${try(local.helm_crds_downgraded[0].name, each.key)}) and re-run"
    }
  }
}
