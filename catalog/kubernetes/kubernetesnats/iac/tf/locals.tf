# Computed values for the KubernetesNats module. Every resolution here has
# an exact twin in the Pulumi module's locals.go / values.go — keep them in
# lockstep.
#
# SECRET DISCIPLINE (load-bearing): nothing in this module's rendered
# values or config carries credential material. Declared users' passwords
# are generated by random_password (main.tf), live ONLY in the
# module-created `<name>-auth` Secret, and reach the server as
# secretKeyRef-backed env vars; the rendered nats.conf carries
# `$NATS_PW_<i>` references (unquoted via the chart's `<< >>` syntax) the
# server resolves from environment at load — verified in the server's
# config parser at the pin.
#
# HCL DISCIPLINE (applies to every conditional object in this file):
# conditional entries are written as `key = cond ? value : null` inside ONE
# object literal, pruned with `{ for k, v in {...} : k => v if v != null }`.
# `cond ? {...} : {}` ternaries fail plan-time type unification when
# branches carry different attributes. Optional nested blocks are read
# with try() (HCL's && does NOT short-circuit); optional scalars inside
# optional blocks with try(coalesce(x), null).

locals {
  # Chart identity — must stay byte-identical with the Pulumi module's
  # vars. NOTE: the nats chart's served index lives under /helm/charts/
  # — the repo-root index.yaml 404s (verified at the pin). The chart and
  # the NATS server move in version lockstep.
  helm_chart_name = "nats"
  helm_chart_repo = "https://nats-io.github.io/k8s/helm/charts/"

  # Release name — metadata.name, NOT a fixed chart name: several NATS
  # systems can coexist in one cluster. fullnameOverride below pins
  # every chart child name to this.
  release_name = var.metadata.name

  # Chart version resolved to the pinned default when unset, so both
  # engines install the same chart whether or not the platform's
  # defaulting middleware ran.
  chart_version = coalesce(var.spec.chart_version, "2.14.2")

  namespace = var.spec.namespace

  # Resource-identity labels stamped on the module-created satellites
  # (the namespace and the auth Secret — never injected into the chart's
  # own resources; Helm owns those).
  labels = merge(
    {
      "planton.ai/resource"      = "true"
      "planton.ai/resource-name" = var.metadata.name
      "planton.ai/resource-kind" = "KubernetesNats"
    },
    var.metadata.id != null && var.metadata.id != "" ? { "planton.ai/resource-id" = var.metadata.id } : {},
    var.metadata.org != null && var.metadata.org != "" ? { "planton.ai/organization" = var.metadata.org } : {},
    var.metadata.env != null && var.metadata.env != "" ? { "planton.ai/environment" = var.metadata.env } : {}
  )

  # ---- auth: one deterministic ordering shared by the Secret, the env ----
  # wiring and the rendered config (byte-identical in the Pulumi twin):
  # flat users indexed in spec order (`NATS_PW_<i>`); account users
  # indexed `NATS_PW_<account-index>_<user-index>`.
  flat_users_meta = [
    for i, u in try(var.spec.auth.users, []) : {
      username    = u.username
      env         = "NATS_PW_${i}"
      permissions = try(u.permissions, null)
    }
  ]
  account_users_meta = flatten([
    for ai, a in try(var.spec.auth.accounts, []) : [
      for ui, u in a.users : {
        username    = u.username
        env         = "NATS_PW_${ai}_${ui}"
        permissions = try(u.permissions, null)
      }
    ]
  ])
  all_users_meta = concat(local.flat_users_meta, local.account_users_meta)
  auth_enabled   = length(local.all_users_meta) > 0

  # Name of the module-generated credential Secret (one key per
  # username); "" without auth. The exported composition handle.
  auth_secret_name = local.auth_enabled ? "${local.release_name}-auth" : ""

  # ---- JetStream: ON by default (the kind's persistent-messaging --------
  # posture; the chart's raw default is off) — rendered explicitly
  # either way so both engines state the posture.
  jetstream_enabled = try(coalesce(var.spec.jet_stream.enabled), null) != null ? var.spec.jet_stream.enabled : true

  # ONE null-pruned comprehension for both postures — never an outer
  # `enabled ? {...} : {enabled=false}` ternary (differently-shaped
  # branches fail plan-time type unification); a disabled JetStream
  # renders only enabled=false.
  jetstream_block = {
    for k, v in {
      enabled = local.jetstream_enabled
      fileStore = local.jetstream_enabled ? {
        for fk, fv in {
          pvc = {
            for pk, pv in {
              size             = try(coalesce(var.spec.jet_stream.disk_size), null) != null ? var.spec.jet_stream.disk_size : "10Gi"
              storageClassName = try(var.spec.jet_stream.storage_class, "") != "" ? var.spec.jet_stream.storage_class : null
            } : pk => pv if pv != null
          }
          maxSize = try(coalesce(var.spec.jet_stream.max_file_store), null)
        } : fk => fv if fv != null
      } : null
      memoryStore = local.jetstream_enabled && try(coalesce(var.spec.jet_stream.memory_store_max_size), null) != null ? {
        enabled = true
        maxSize = var.spec.jet_stream.memory_store_max_size
      } : null
    } : k => v if v != null
  }

  # ---- per-user config entries -------------------------------------------
  # The password is a `<< $NATS_PW_<i> >>` reference the chart unquotes
  # into `$NATS_PW_<i>`, which the server resolves from the container
  # environment (the secretKeyRef env wiring below).
  user_entries_by_env = {
    for u in local.all_users_meta : u.env => {
      for k, v in {
        user     = u.username
        password = format("<< $%s >>", u.env)
        permissions = u.permissions == null ? null : {
          for pk, pv in {
            publish = length(try(u.permissions.publish_allow, [])) > 0 || length(try(u.permissions.publish_deny, [])) > 0 ? {
              for ak, av in {
                allow = length(try(u.permissions.publish_allow, [])) > 0 ? u.permissions.publish_allow : null
                deny  = length(try(u.permissions.publish_deny, [])) > 0 ? u.permissions.publish_deny : null
              } : ak => av if av != null
            } : null
            subscribe = length(try(u.permissions.subscribe_allow, [])) > 0 || length(try(u.permissions.subscribe_deny, [])) > 0 ? {
              for ak, av in {
                allow = length(try(u.permissions.subscribe_allow, [])) > 0 ? u.permissions.subscribe_allow : null
                deny  = length(try(u.permissions.subscribe_deny, [])) > 0 ? u.permissions.subscribe_deny : null
              } : ak => av if av != null
            } : null
          } : pk => pv if pv != null
        }
      } : k => v if v != null
    }
  }

  # ---- the auth config merge -----------------------------------------------
  # authorization users XOR accounts (CEL-enforced on the spec).
  config_merge_block = local.auth_enabled ? {
    for k, v in {
      authorization = length(local.flat_users_meta) > 0 ? {
        users = [for u in local.flat_users_meta : local.user_entries_by_env[u.env]]
      } : null
      accounts = length(try(var.spec.auth.accounts, [])) > 0 ? {
        for ai, a in var.spec.auth.accounts : a.name => {
          for ak, av in {
            users     = [for ui, u in a.users : local.user_entries_by_env["NATS_PW_${ai}_${ui}"]]
            jetstream = a.jet_stream_enabled ? "enabled" : null
          } : ak => av if av != null
        }
      } : null
      no_auth_user = try(var.spec.auth.no_auth_user, "") != "" ? var.spec.auth.no_auth_user : null
    } : k => v if v != null
  } : null

  # ---- config ------------------------------------------------------------------
  config_block = {
    for k, v in {
      # Clustering: with the block disabled the chart runs exactly one
      # server (its own template ignores replicas then).
      cluster = try(var.spec.cluster.enabled, false) ? {
        enabled  = true
        replicas = try(coalesce(var.spec.cluster.replicas), null) != null ? var.spec.cluster.replicas : 3
      } : null

      jetstream = local.jetstream_block

      # Client-listener TLS: the chart mounts the Secret and renders the
      # cert/key paths; verify_clients adds mutual-TLS enforcement with
      # the CA bundle from the same Secret (cert-manager includes
      # ca.crt).
      nats = try(var.spec.tls, null) != null ? {
        tls = {
          for tk, tv in {
            enabled    = true
            secretName = var.spec.tls.secret_name
            merge = var.spec.tls.verify_clients ? {
              verify  = true
              ca_file = "/etc/nats-certs/nats/ca.crt"
            } : null
          } : tk => tv if tv != null
        }
      } : null

      # WebSocket: the SERVER refuses a websocket listener without TLS
      # unless no_tls is explicit (verified in the server source at the
      # pin) — the typed arm is plain-in-cluster, so no_tls rides the
      # block's merge; websocket TLS is helm_values territory (a TLS
      # config, when merged there, wins over no_tls server-side).
      websocket = try(var.spec.websocket.enabled, false) ? {
        enabled = true
        port    = try(coalesce(var.spec.websocket.port), null) != null ? var.spec.websocket.port : 8080
        merge   = { no_tls = true }
      } : null

      # MQTT (JetStream-backed — CEL enforces the pairing on the spec).
      mqtt = try(var.spec.mqtt.enabled, false) ? {
        enabled = true
        port    = try(coalesce(var.spec.mqtt.port), null) != null ? var.spec.mqtt.port : 1883
      } : null

      # Leafnodes (the hub side).
      leafnodes = try(var.spec.leafnodes.enabled, false) ? {
        enabled = true
        port    = try(coalesce(var.spec.leafnodes.port), null) != null ? var.spec.leafnodes.port : 7422
      } : null

      merge = local.config_merge_block
    } : k => v if v != null
  }

  # ---- container -----------------------------------------------------------------
  container_env = local.auth_enabled ? {
    for u in local.all_users_meta : u.env => {
      valueFrom = {
        secretKeyRef = {
          name = local.auth_secret_name
          key  = u.username
        }
      }
    }
  } : null

  container_resources = try(var.spec.resources, null) == null ? null : {
    for rk, rv in {
      requests = try(var.spec.resources.requests, null) == null ? null : {
        for qk, qv in {
          cpu    = var.spec.resources.requests.cpu != "" ? var.spec.resources.requests.cpu : null
          memory = var.spec.resources.requests.memory != "" ? var.spec.resources.requests.memory : null
        } : qk => qv if qv != null
      }
      limits = try(var.spec.resources.limits, null) == null ? null : {
        for lk, lv in {
          cpu    = var.spec.resources.limits.cpu != "" ? var.spec.resources.limits.cpu : null
          memory = var.spec.resources.limits.memory != "" ? var.spec.resources.limits.memory : null
        } : lk => lv if lv != null
      }
    } : rk => rv if rv != null && rv != {}
  }

  # ---- image overrides -----------------------------------------------------------
  # The chart splits registry from repository internally; a repository
  # value carrying a registry host works as-is (the chart prepends its
  # registry value only when one is set), so the COMBINED repo form maps
  # onto {repository, tag} directly.
  images_or_null = {
    nats     = try(var.spec.images.nats, null)
    reloader = try(var.spec.images.reloader, null)
    exporter = try(var.spec.images.exporter, null)
    nats_box = try(var.spec.images.nats_box, null)
  }

  rendered_images = {
    for name, img in local.images_or_null : name => img == null ? null : {
      for k, v in {
        repository = img.repo != "" ? img.repo : null
        tag        = img.tag != "" ? img.tag : null
      } : k => v if v != null
    }
  }

  image_pull_secret_names = distinct([
    for img in values(local.images_or_null) : img.pull_secret_name
    if img != null && try(img.pull_secret_name, "") != ""
  ])

  container_block = {
    for k, v in {
      env       = local.container_env
      resources = local.container_resources
      image     = local.rendered_images.nats
    } : k => v if v != null && v != {}
  }

  # ---- client Service exposure ------------------------------------------------------
  # The chart has no first-class type/annotations values — both ride its
  # Service merge patch.
  service_type = try(var.spec.service.type, "") == "load_balancer" ? "LoadBalancer" : (
    try(var.spec.service.type, "") == "node_port" ? "NodePort" : ""
  )
  service_merge = {
    for k, v in {
      spec = local.service_type != "" ? { type = local.service_type } : null
      metadata = length(try(var.spec.service.annotations, {})) > 0 ? {
        annotations = var.spec.service.annotations
      } : null
    } : k => v if v != null
  }

  # ---- scheduling (the pod-template merge patch) --------------------------------------
  scheduling_pod_spec = {
    for k, v in {
      nodeSelector = length(try(var.spec.scheduling.node_selector, {})) > 0 ? var.spec.scheduling.node_selector : null
      tolerations = length(try(var.spec.scheduling.tolerations, [])) > 0 ? [
        for t in var.spec.scheduling.tolerations : {
          for tk, tv in {
            key               = t.key != "" ? t.key : null
            operator          = t.operator != "" ? t.operator : null
            value             = t.value != "" ? t.value : null
            effect            = t.effect != "" ? t.effect : null
            tolerationSeconds = try(t.toleration_seconds, null)
          } : tk => tv if tv != null
        }
      ] : null
    } : k => v if v != null
  }

  # ---- nats-box -------------------------------------------------------------------------
  nats_box_enabled = try(coalesce(var.spec.nats_box_enabled), null) != null ? var.spec.nats_box_enabled : true
  nats_box_block = {
    for k, v in {
      enabled   = local.nats_box_enabled ? null : false
      container = local.rendered_images.nats_box != null ? { image = local.rendered_images.nats_box } : null
    } : k => v if v != null
  }

  # ---- typed chart values (twin of the Pulumi module's buildHelmValues) ----
  helm_values = {
    for k, v in {
      # fullnameOverride pins every child name (`<name>`,
      # `<name>-headless`, `<name>-box`, ...) to the resource name; the
      # exported outputs are built from that contract.
      fullnameOverride = local.release_name

      config = local.config_block

      container = length(local.container_block) > 0 ? local.container_block : null

      reloader = local.rendered_images.reloader != null ? { image = local.rendered_images.reloader } : null

      promExporter = try(var.spec.metrics.exporter_enabled, false) ? {
        for pk, pv in {
          enabled    = true
          podMonitor = try(var.spec.metrics.pod_monitor_enabled, false) ? { enabled = true } : null
          image      = local.rendered_images.exporter
        } : pk => pv if pv != null
      } : null

      natsBox = length(local.nats_box_block) > 0 ? local.nats_box_block : null

      service = length(local.service_merge) > 0 ? { merge = local.service_merge } : null

      podTemplate = length(local.scheduling_pod_spec) > 0 ? {
        merge = { spec = local.scheduling_pod_spec }
      } : null

      global = length(local.image_pull_secret_names) > 0 ? {
        image = { pullSecretNames = local.image_pull_secret_names }
      } : null
    } : k => v if v != null && v != {}
  }
}
